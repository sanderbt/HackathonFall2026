{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "types": ["node"]
    },
    "include": ["src"]
}
